[Unit]
Description=Trigger Redbot scheduled semantic filtering
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/redbotleads.com
EnvironmentFile=/home/azureuser/redbotleads.com/.env.semantic-cron
ExecStart=/usr/bin/bash /home/azureuser/redbotleads.com/scripts/trigger-hourly-semantic.sh
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
