[Unit]
Description=Back up Redbot PostgreSQL to S3
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/redbotleads.com
EnvironmentFile=/etc/redbot-backup.env
ExecStart=/usr/bin/sh /home/ubuntu/redbotleads.com/scripts/backup-postgres-s3.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
